{
  "name": "albawardi",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @albawardi/shared test",
    "typecheck": "pnpm -r --no-bail typecheck",
    "dev:client": "pnpm --filter @albawardi/client dev",
    "dev:lab": "pnpm --filter @albawardi/sensor-lab dev",
    "preview:client": "pnpm --filter @albawardi/client preview",
    "preview:lab": "pnpm --filter @albawardi/sensor-lab preview"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
